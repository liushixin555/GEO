generator client {
  provider = "prisma-client-js"
}

generator openapi {
  provider = "node node_modules/prisma-openapi/dist/index.js"
  output   = "../apis/prisma-openapi"
  title    = "薄云商机倍增服务 API"
  version  = "1.0.0"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id            Int     @id @default(autoincrement())
  shortName     String  @map("short_name") @db.VarChar(50)
  fullName      String  @map("full_name") @db.VarChar(200)
  address       String? @db.VarChar(500)
  contactPerson String  @map("contact_person") @db.VarChar(100)
  contactPhone  String  @map("contact_phone") @db.VarChar(20)
  status        Boolean @default(true)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  createdById   Int?     @map("created_by")
  updatedById   Int?     @map("updated_by")
  users         User[]
  projects      Project[]
  knowledgeBases KnowledgeBase[]
  selectedByUsers User[] @relation("UserSelectedCompany")
  todos           Todo[]
  createdBy       User?  @relation("CompanyCreator", fields: [createdById], references: [id])
  updatedBy       User?  @relation("CompanyUpdater", fields: [updatedById], references: [id])

  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  @@map("companies")
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique @db.VarChar(100)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  cnName       String   @map("cn_name") @db.VarChar(100)
  role         Role     @default(view)
  status       Boolean  @default(true)
  companyId    Int?     @map("company_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  company      Company? @relation(fields: [companyId], references: [id])
  selectedCompanyId  Int?     @map("selected_company_id")
  selectedProjectId  Int?     @map("selected_project_id")
  selectedCompany    Company? @relation("UserSelectedCompany", fields: [selectedCompanyId], references: [id])
  selectedProject    Project? @relation("UserSelectedProject", fields: [selectedProjectId], references: [id])
  operatedProjects ProjectOperator[] @relation("UserProjectOperator")
  viewedProjects  ProjectViewer[] @relation("UserProjectViewer")
  createdSkills        Skills[]              @relation("SkillsCreator")
  createdArticles      Article[]             @relation("ArticleCreator")
  articleVersions      ArticleVersion[]      @relation("ArticleVersionCreator")
  createdSchedules     PublishingSchedule[]  @relation("ScheduleCreator")
  createdKeywords      KnowledgeKeyword[]    @relation("KnowledgeKeywordCreator")
  createdPortraits     KnowledgePortrait[]   @relation("KnowledgePortraitCreator")
  createdImages        KnowledgeImage[]      @relation("KnowledgeImageCreator")
  createdDocuments     KnowledgeDocument[]   @relation("KnowledgeDocumentCreator")
  createdKnowledgeBases KnowledgeBase[]      @relation("KnowledgeBaseCreator")
  createdCompanies     Company[]             @relation("CompanyCreator")
  updatedCompanies     Company[]             @relation("CompanyUpdater")
  assignedTodos        Todo[]                @relation("TodoAssignee")
  createdTodos         Todo[]                @relation("TodoCreator")
  todoLogOperations    TodoLog[]             @relation("TodoLogOperator")
  audits               Audit[]               @relation("AuditCreator")

  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  @@index([username])
  @@index([companyId])
  @@index([role])
  @@map("users")
}

enum Role {
  sysadmin
  admin
  view
}

enum ArticleStatus {
  draft
  manual_writing
  generating
  generate_failed
  pending_review
  approved
}

enum PublishingScheduleStatus {
  pending
  publishing
  published
  publish_failed
}

enum KnowledgeScope {
  platform
  company
  project
}

model Skills {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(200)
  description String?  @db.VarChar(500)
  skillDir    String   @default("") @map("skill_dir") @db.VarChar(500)
  createdBy   Int?     @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  creator     User?    @relation("SkillsCreator", fields: [createdBy], references: [id])

  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  @@unique([name])
  @@map("skills")
}

model LlmModel {
  id        Int      @id @default(autoincrement())
  provider  String   @db.VarChar(100)
  baseUrl   String   @map("base_url") @db.VarChar(500)
  apiKey    String   @map("api_key") @db.VarChar(500)
  modelName String   @map("model_name") @db.VarChar(200)
  status    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  articles  Article[]

  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  @@map("llm_models")
}

model PublishingPlatform {
  id           Int      @id @default(autoincrement())
  rmResourceId Int      @unique @map("rm_resource_id")
  name         String   @db.VarChar(200)
  taxonomy     String   @db.VarChar(100)
  price        Float    @default(0)
  remark       String?  @db.VarChar(500)
  includeRate  Float    @default(0) @map("include_rate")
  publishRate  Float    @default(0) @map("publish_rate")
  isFavorite   Boolean  @default(false) @map("is_favorite")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  orders       PublishingPlatformOrder[]

  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  @@index([rmResourceId])
  @@index([taxonomy])
  @@map("publishing_platforms")
}

model SystemConfig {
  id          Int      @id @default(autoincrement())
  configKey   String   @unique @map("config_key") @db.VarChar(100)
  configValue String   @map("config_value") @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  @@map("system_configs")
}

model Project {
  id          Int      @id @default(autoincrement())
  shortName   String   @map("short_name") @db.VarChar(50)
  fullName    String   @map("full_name") @db.VarChar(200)
  description String?  @db.VarChar(500)
  companyId   Int      @map("company_id")
  status      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  company     Company  @relation(fields: [companyId], references: [id])
  operators   ProjectOperator[]
  viewers     ProjectViewer[]
  articles    Article[]
  selectedByUsers User[] @relation("UserSelectedProject")
  knowledgeBases KnowledgeBase[]
  todos          Todo[]

  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  @@index([companyId])
  @@index([status])
  @@map("projects")
}

model ProjectOperator {
  projectId Int @map("project_id")
  userId    Int @map("user_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation("UserProjectOperator", fields: [userId], references: [id], onDelete: Cascade)

  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  @@id([projectId, userId])
  @@index([userId])
  @@map("project_operators")
}

model ProjectViewer {
  projectId Int @map("project_id")
  userId    Int @map("user_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation("UserProjectViewer", fields: [userId], references: [id], onDelete: Cascade)

  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  @@id([projectId, userId])
  @@index([userId])
  @@map("project_viewers")
}

model KnowledgeBase {
  id          Int             @id @default(autoincrement())
  name        String          @db.VarChar(200)
  description String?         @db.VarChar(500)
  scope       KnowledgeScope  @default(project)
  companyId   Int?            @map("company_id")
  projectId   Int?            @map("project_id")
  status      Boolean         @default(true)
  createdBy   Int?            @map("created_by")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  company     Company?        @relation(fields: [companyId], references: [id])
  project     Project?        @relation(fields: [projectId], references: [id])
  creator     User?           @relation("KnowledgeBaseCreator", fields: [createdBy], references: [id])
  keywords      KnowledgeKeyword[]
  portraits     KnowledgePortrait[]
  images        KnowledgeImage[]
  documents     KnowledgeDocument[]
  minedKeywords MinedKeyword[]

  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  @@index([scope])
  @@index([companyId])
  @@index([projectId])
  @@map("knowledge_bases")
}

model Article {
  id          Int           @id @default(autoincrement())
  projectId   Int           @map("project_id")
  title       String        @db.VarChar(500)
  articleType String?       @map("article_type") @db.VarChar(50)
  writeMode   String?       @map("write_mode") @db.VarChar(20)
  keywords    String?       @db.VarChar(500)
  portrait    String?
  images      Json?
  skills      Json?
  llmModelId  Int?          @map("llm_model_id")
  content     String?
  revisionInstruction String? @map("revision_instruction")
  version     Float         @default(1.0)
  status              ArticleStatus @default(draft)
  createdBy           Int?          @map("created_by")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator     User?         @relation("ArticleCreator", fields: [createdBy], references: [id])
  llmModel    LlmModel?     @relation(fields: [llmModelId], references: [id], onDelete: SetNull)
  versions    ArticleVersion[]
  schedules   PublishingSchedule[]
  generationDebugs ArticleGenerationDebug[]

  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  @@index([projectId])
  @@index([status])
  @@index([createdBy])
  @@map("articles")
}

model ArticleVersion {
  id        Int      @id @default(autoincrement())
  articleId Int      @map("article_id")
  version   Float
  content   String
  createdBy Int?     @map("created_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  creator   User?    @relation("ArticleVersionCreator", fields: [createdBy], references: [id])
  generationDebugs ArticleGenerationDebug[]

  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  @@index([articleId])
  @@map("article_versions")
}

model ArticleGenerationDebug {
  id                     Int      @id @default(autoincrement())
  articleId              Int      @map("article_id")
  articleVersionId       Int?     @map("article_version_id")
  modelName              String?  @map("model_name") @db.VarChar(200)
  skillDirs              Json?    @map("skill_dirs")
  requiredReferenceFiles Json?    @map("required_reference_files")
  systemPrompt           String   @map("system_prompt")
  userPrompt             String   @map("user_prompt")
  toolCalls              Json?    @map("tool_calls")
  rawLlmOutput           String?  @map("raw_llm_output")
  cleanedOutput          String?  @map("cleaned_output")
  warnings               Json?
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz()

  article        Article         @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleVersion ArticleVersion? @relation(fields: [articleVersionId], references: [id], onDelete: SetNull)

  @@index([articleId])
  @@index([articleVersionId])
  @@map("article_generation_debugs")
}

model KnowledgeKeyword {
  id        Int             @id @default(autoincrement())
  baseId    Int             @map("base_id")
  keyword   String          @db.VarChar(200)
  seedWord  String?         @map("seed_word") @db.VarChar(200)
  groupId   Int?            @map("group_id")
  createdBy Int?            @map("created_by")
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  base      KnowledgeBase   @relation(fields: [baseId], references: [id], onDelete: Cascade)
  creator   User?           @relation("KnowledgeKeywordCreator", fields: [createdBy], references: [id])
  expandedWords KeywordExpandedWord[]

  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  @@index([baseId])
  @@map("knowledge_keywords")
}

model KeywordExpandedWord {
  id        Int      @id @default(autoincrement())
  keywordId Int      @map("keyword_id")
  word      String   @db.VarChar(200)
  selected  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  keyword   KnowledgeKeyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  @@index([keywordId])
  @@map("keyword_expanded_words")
}

model MinedKeyword {
  id         Int      @id @default(autoincrement())
  baseId     Int      @map("base_id")
  keyword    String   @db.VarChar(200)
  sourceType String   @default("all") @map("source_type") @db.VarChar(20)
  selected   Boolean  @default(false)
  createdBy  Int?     @map("created_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  base      KnowledgeBase @relation(fields: [baseId], references: [id], onDelete: Cascade)

  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  @@unique([baseId, keyword])
  @@index([baseId])
  @@map("mined_keywords")
}

model KnowledgePortrait {
  id        Int             @id @default(autoincrement())
  baseId    Int             @map("base_id")
  title     String          @db.VarChar(200)
  content   String?         @db.Text
  createdBy Int?            @map("created_by")
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  base      KnowledgeBase   @relation(fields: [baseId], references: [id], onDelete: Cascade)
  creator   User?           @relation("KnowledgePortraitCreator", fields: [createdBy], references: [id])

  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  @@index([baseId])
  @@map("knowledge_portraits")
}

model KnowledgeImage {
  id          Int             @id @default(autoincrement())
  baseId      Int             @map("base_id")
  title       String          @db.VarChar(200)
  description String?         @db.VarChar(500)
  imageUrl    String          @map("image_url") @db.VarChar(500)
  createdBy   Int?            @map("created_by")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  base        KnowledgeBase   @relation(fields: [baseId], references: [id], onDelete: Cascade)
  creator     User?           @relation("KnowledgeImageCreator", fields: [createdBy], references: [id])

  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  @@index([baseId])
  @@map("knowledge_images")
}

model KnowledgeDocument {
  id          Int             @id @default(autoincrement())
  baseId      Int             @map("base_id")
  title       String          @db.VarChar(200)
  description String?         @db.VarChar(500)
  fileUrl     String          @map("file_url") @db.VarChar(500)
  fileName    String          @map("file_name") @db.VarChar(255)
  fileType    String          @map("file_type") @db.VarChar(20)
  fileSize    Int             @map("file_size")
  createdBy   Int?            @map("created_by")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  base        KnowledgeBase   @relation(fields: [baseId], references: [id], onDelete: Cascade)
  creator     User?           @relation("KnowledgeDocumentCreator", fields: [createdBy], references: [id])

  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  @@index([baseId])
  @@map("knowledge_documents")
}

enum TodoSource {
  manual
  content_iteration
  smart_link
  daily_check
  risk_warning
}

enum TodoPriority {
  P0
  P1
  P2
  P3
  P4
}

enum TodoStatus {
  open
  closed
  draft
}

enum TodoLogAction {
  submit
  close
  reopen
  transfer
  reject
}

model Todo {
  id          Int          @id @default(autoincrement())
  title       String       @db.VarChar(500)
  companyId   Int          @map("company_id")
  projectId   Int?         @map("project_id")
  objectType  String       @map("object_type") @db.VarChar(100)
  objectId    Int?         @map("object_id")
  action      String       @db.VarChar(500)
  source      TodoSource   @default(manual)
  priority    TodoPriority @default(P2)
  assigneeId  Int          @map("assignee_id")
  status      TodoStatus   @default(open)
  dueAt       DateTime?    @map("due_at") @db.Timestamptz()
  createdById Int          @map("created_by_id")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt   DateTime?    @map("deleted_at") @db.Timestamptz()

  company     Company      @relation(fields: [companyId], references: [id])
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assignee    User         @relation("TodoAssignee", fields: [assigneeId], references: [id])
  createdBy   User         @relation("TodoCreator", fields: [createdById], references: [id])
  logs        TodoLog[]

  @@index([companyId])
  @@index([assigneeId])
  @@index([status])
  @@index([priority])
  @@index([source])
  @@map("todos")
}

model TodoLog {
  id          Int            @id @default(autoincrement())
  todoId      Int            @map("todo_id")
  operatorId  Int            @map("operator_id")
  action      TodoLogAction
  objectType  String?        @map("object_type") @db.VarChar(100)
  objectId    Int?           @map("object_id")
  remark      String?        @db.VarChar(500)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz()

  todo        Todo           @relation(fields: [todoId], references: [id], onDelete: Cascade)
  operator    User           @relation("TodoLogOperator", fields: [operatorId], references: [id])

  @@index([todoId])
  @@map("todo_logs")
}

enum AuditLogLevel {
  debug
  info
  warn
  error
}

model AuditLog {
  id        Int           @id @default(autoincrement())
  level     AuditLogLevel @default(info)
  event     String        @db.VarChar(100)
  userId    Int?          @map("user_id")
  ip        String?       @db.VarChar(45)
  method    String?       @db.VarChar(10)
  url       String?       @db.VarChar(500)
  status    Int?
  duration  Int?
  metadata  Json?
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz()

  @@index([level])
  @@index([event])
  @@index([createdAt])
  @@map("audit_logs")
}

model PublishingSchedule {
  id                Int                    @id @default(autoincrement())
  articleId         Int                    @map("article_id")
  platforms         Json?
  scheduleType      String?                @map("schedule_type") @db.VarChar(20)
  scheduledPublishAt DateTime?             @map("scheduled_publish_at") @db.Timestamptz()
  status            PublishingScheduleStatus @default(pending)
  rejectReason      String?                @map("reject_reason") @db.VarChar(500)
  createdBy         Int?                   @map("created_by")
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  article           Article                @relation(fields: [articleId], references: [id], onDelete: Cascade)
  creator           User?                  @relation("ScheduleCreator", fields: [createdBy], references: [id])
  platformOrders    PublishingPlatformOrder[]

  deletedAt         DateTime?              @map("deleted_at") @db.Timestamptz()
  @@index([articleId])
  @@index([status])
  @@map("publishing_schedules")
}

model PublishingPlatformOrder {
  id                Int                 @id @default(autoincrement())
  scheduleId        Int                 @map("schedule_id")
  platformId        Int                 @map("platform_id")
  rmOrderId         String              @unique @map("rm_order_id") @db.VarChar(100)
  rmStatus          Int                 @default(0) @map("rm_status")
  rmResponseMessage String?             @map("rm_response_message") @db.VarChar(1000)
  rmResourceName    String?             @map("rm_resource_name") @db.VarChar(200)
  lastSyncedAt      DateTime?           @map("last_synced_at") @db.Timestamptz()
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  schedule          PublishingSchedule  @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  platform          PublishingPlatform  @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@index([scheduleId])
  @@index([platformId])
  @@index([rmStatus])
  @@map("publishing_platform_orders")
}

model PublishedArticleLink {
  id            Int      @id @default(autoincrement())
  articleId     Int      @map("article_id")
  scheduleId    Int?     @map("schedule_id")
  platformName  String?  @map("platform_name") @db.VarChar(200)
  url           String   @db.VarChar(1000)
  normalizedUrl String   @map("normalized_url") @db.VarChar(1000)
  domain        String?  @db.VarChar(200)
  createdBy     Int?     @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz()

  @@index([articleId])
  @@index([scheduleId])
  @@index([normalizedUrl])
  @@map("published_article_links")
}

model AiCitationDetectionRun {
  id          Int      @id @default(autoincrement())
  projectId   Int?     @map("project_id")
  modelName   String   @map("model_name") @db.VarChar(100)
  prompt      String?  @db.Text
  answer      String?  @db.Text
  status      String   @default("completed") @db.VarChar(30)
  createdBy   Int?     @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  completedAt DateTime? @map("completed_at") @db.Timestamptz()
  records     AiCitationRecord[]

  @@index([projectId])
  @@index([modelName])
  @@index([createdAt])
  @@map("ai_citation_detection_runs")
}

model AiCitationRecord {
  id                  Int      @id @default(autoincrement())
  runId               Int      @map("run_id")
  modelName           String   @map("model_name") @db.VarChar(100)
  sourceUrl           String   @map("source_url") @db.VarChar(1000)
  normalizedSourceUrl String   @map("normalized_source_url") @db.VarChar(1000)
  sourceTitle         String?  @map("source_title") @db.VarChar(500)
  domain              String?  @db.VarChar(200)
  matched             Boolean  @default(false)
  articleId           Int?     @map("article_id")
  articleLinkId       Int?     @map("article_link_id")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz()
  run                 AiCitationDetectionRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([articleId])
  @@index([articleLinkId])
  @@index([normalizedSourceUrl])
  @@map("ai_citation_records")
}

model ArticleModelCitationMark {
  id             Int      @id @default(autoincrement())
  articleId      Int      @map("article_id")
  modelName      String   @map("model_name") @db.VarChar(100)
  firstMatchedAt DateTime @map("first_matched_at") @db.Timestamptz()
  lastMatchedAt  DateTime @map("last_matched_at") @db.Timestamptz()
  matchCount     Int      @default(1) @map("match_count")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  @@unique([articleId, modelName])
  @@index([articleId])
  @@index([modelName])
  @@map("article_model_citation_marks")
}

/// 诊断管理 — 一次"AI 可见度诊断"任务（替代 geo-audit Redis KV）
model Audit {
  id          Int      @id @default(autoincrement())
  jobId       String   @unique @map("job_id") @db.VarChar(40)
  userId      Int      @map("user_id")
  companyId   Int?     @map("company_id")
  brand       String   @db.VarChar(200)
  website     String?  @db.VarChar(500)
  industry    String?  @db.VarChar(200)
  description String?  @db.Text
  competitors Json?
  keywords    Json?
  features    Json?
  tier        String   @default("pro") @db.VarChar(20)
  /// processing / complete / failed
  status      String   @default("processing") @db.VarChar(20)
  score       Int?
  grade       String?  @db.VarChar(2)
  /// 完整结果快照（AuditResult JSON）
  result      Json?
  aioResult        Json? @map("aio_result")
  technicalResult  Json? @map("technical_result")
  seoScoreResult   Json? @map("seo_score_result")
  contentOptimizerResult Json? @map("content_optimizer_result")
  engineCount Int @default(0) @map("engine_count")
  promptTotal Int @default(0) @map("prompt_total")
  promptDone  Int @default(0) @map("prompt_done")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz()

  prompts     AuditPrompt[]
  user        User      @relation("AuditCreator", fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([companyId])
  @@index([status])
  @@map("audits")
}

/// 诊断 prompt — 每个引擎 × 每个 prompt 的执行单元
model AuditPrompt {
  id          Int      @id @default(autoincrement())
  auditId     Int      @map("audit_id")
  promptIndex Int      @map("prompt_index")
  /// brand/category/competitor/buying_intent/conversational/discovery
  category    String   @db.VarChar(40)
  /// provider 名称（来自 LlmModel.provider）
  engine      String   @db.VarChar(40)
  llmModelId  Int?     @map("llm_model_id")
  prompt      String   @db.Text
  result      AuditPromptResult?

  audit       Audit    @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@unique([auditId, promptIndex, engine])
  @@index([auditId])
  @@map("audit_prompts")
}

/// 诊断 prompt 结果 — 单次引擎调用的响应分析
model AuditPromptResult {
  id            Int      @id @default(autoincrement())
  auditPromptId Int      @unique @map("audit_prompt_id")
  mentioned     Boolean  @default(false)
  snippet       String?  @db.Text
  fullResponse  String?  @map("full_response") @db.Text
  /// positive/neutral/negative
  sentiment     String?  @db.VarChar(20)
  sourceType    String?  @map("source_type") @db.VarChar(40)
  blindSpot     Boolean  @default(false) @map("blind_spot")
  latencyMs     Int?     @map("latency_ms")
  error         String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  auditPrompt   AuditPrompt @relation(fields: [auditPromptId], references: [id], onDelete: Cascade)

  @@map("audit_prompt_results")
}
