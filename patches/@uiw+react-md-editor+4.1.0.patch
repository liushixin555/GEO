+/**
+ * Checks if a line is a Markdown table row (starts with '|')
+ */
+function isTableRow(line: string): boolean {
+  return line.trim().startsWith('|');
+}
+
+/**
+ * Checks if a line is a Markdown table separator (e.g. |---|---|)
+ */
+function isTableSeparator(line: string): boolean {
+  return /^\|[\s]*-{3,}[\s]*(\|[\s]*-{3,}[\s]*)*\|?$/.test(line.trim());
+}
+
+/**
+ * Finds the full table block range containing the given cursor position.
+ * Returns null if the cursor is not inside a valid Markdown table.
+ */
+function findTableBlock(text: string, position: number): { start: number; end: number } | null {
+  const lines = text.split('\n');
+  let charPos = 0;
+  let cursorLine = 0;
+
+  // Find which line the cursor is on
+  for (let i = 0; i < lines.length; i++) {
+    const lineEnd = charPos + lines[i].length;
+    if (position <= lineEnd) {
+      cursorLine = i;
+      break;
+    }
+    charPos = lineEnd + 1;
+    if (i === lines.length - 1) cursorLine = i;
+  }
+
+  // Check if cursor line is a table row or separator
+  if (!isTableRow(lines[cursorLine]) && !isTableSeparator(lines[cursorLine])) {
+    return null;
+  }
+
+  // Expand upward to find table start
+  let startLine = cursorLine;
+  while (startLine > 0 && (isTableRow(lines[startLine - 1]) || isTableSeparator(lines[startLine - 1]))) {
+    startLine--;
+  }
+
+  // Expand downward to find table end
+  let endLine = cursorLine;
+  while (endLine < lines.length - 1 && (isTableRow(lines[endLine + 1]) || isTableSeparator(lines[endLine + 1]))) {
+    endLine++;
+  }
+
+  // Validate: block must contain a separator line to be a real table
+  let hasSeparator = false;
+  for (let i = startLine; i <= endLine; i++) {
+    if (isTableSeparator(lines[i])) {
+      hasSeparator = true;
+      break;
+    }
+  }
+  if (!hasSeparator) return null;
+
+  // Convert line indices to character positions
+  let start = 0;
+  for (let i = 0; i < startLine; i++) {
+    start += lines[i].length + 1;
+  }
+
+  let end = start;
+  for (let i = startLine; i <= endLine; i++) {
+    end += lines[i].length + 1;
+  }
+  end = Math.min(end, text.length);
+
+  return { start, end };
