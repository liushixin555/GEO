+ * Returns true if the URL uses a safe scheme or is a relative path.
+ */
+function isSafeUrl(text: string): boolean {
+  const trimmed = text.trim();
+  // Allow relative paths and anchors
+  if (!trimmed.includes(':') || trimmed.startsWith('//') || trimmed.startsWith('/') || trimmed.startsWith('#')) {
+    return true;
+  }
+  const scheme = trimmed.split(':')[0].toLowerCase();
+  return SAFE_URL_SCHEMES.has(scheme);
+}
+
+/**
+ * S4: Clamps selection range to valid text bounds.
+ */
+function clampSelection(range: { start: number; end: number }, maxLength: number) {
+  return {
+    start: Math.max(0, Math.min(range.start, maxLength)),
+    end: Math.max(0, Math.min(range.end, maxLength)),
+  };
+}
