{
  "name": "geo-ts",
  "version": "1.0.0",
  "description": "薄云GEO - Enterprise management platform",
  "private": true,
  "scripts": {
    "dev:api": "ts-node --project tsconfig.api.json apis/server.ts",
    "dev:page": "vite --config vite.config.ts",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:page\"",
    "build:api": "tsc -p tsconfig.api.json",
    "build:page": "vite build --config vite.config.ts",
    "build": "npm run build:api && npm run build:page",
    "test": "jest --config jest.config.ts",
    "test:watch": "jest --config jest.config.ts --watch",
    "test:api": "jest --config jest.config.ts --testPathPattern=tests/apis",
    "test:page": "jest --config jest.config.ts --testPathPattern=tests/pages",
    "lint": "eslint apis/ pages/ --ext .ts,.tsx",
    "db:migrate": "npx prisma migrate dev",
    "db:migrate:deploy": "npx prisma migrate deploy",
    "db:migrate:create": "npx prisma migrate dev --create-only",
    "db:push": "npx prisma db push",
    "db:seed": "npx prisma db seed",
    "db:studio": "npx prisma studio",
    "db:generate": "npx prisma generate",
    "start": "node dist/apis/server.js",
    "postinstall": "npx prisma generate"
  },
  "dependencies": {
    "@ant-design/icons": "^6.2.3",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@prisma/client": "^5.22.0",
    "@uiw/react-md-editor": "^4.1.0",
    "adm-zip": "^0.5.17",
    "antd": "^6.4.1",
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dayjs": "^1.11.20",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "fast-xml-parser": "^5.8.0",
    "helmet": "^8.0.0",
    "js-yaml": "^4.1.1",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.0",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "pg": "^8.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/adm-zip": "^0.5.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.1.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/supertest": "^6.0.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.0.1",
    "eslint": "^9.14.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "prisma": {
    "seed": "ts-node --project tsconfig.api.json prisma/seed.ts"
  }
}
