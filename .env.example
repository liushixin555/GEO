# Server
PORT=8080
NODE_ENV=development

# Database (Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/geo_ts?schema=public

# Database (individual fields, used by config)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=geo_ts
DB_USER=postgres
DB_PASSWORD=postgres

# JWT
# Required in production! Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# In development, a random secret is auto-generated on each startup.
JWT_SECRET=
JWT_EXPIRES_IN=2h

# Swagger
SWAGGER_ENABLED=true

# Rate Limit
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# CORS (comma-separated, each must start with http:// or https://)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cron
CRON_ARTICLE_INTERVAL=*/5 * * * *
CRON_ARTICLE_ENABLED=true
CRON_PUBLISHING_INTERVAL=*/1 * * * *
CRON_PUBLISHING_ENABLED=true

# 软盟 API
RM_API_KEY=3b98c40be00c15f9ec69131076646eb7

# API Key 加密密钥（用于加密存储 LLM API Key）
# 生成方式: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY_ENCRYPTION_KEY=
