{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev",
      "type": "shell",
      "command": "pnpm.cmd run dev",
      "options": {
        "env": {
          "CI": "true"
        }
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "dev:api",
      "type": "shell",
      "command": "pnpm.cmd run dev:api",
      "options": {
        "env": {
          "CI": "true"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "dev:page",
      "type": "shell",
      "command": "pnpm.cmd run dev:page",
      "options": {
        "env": {
          "CI": "true"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "build",
      "type": "shell",
      "command": "pnpm.cmd run build",
      "options": {
        "env": {
          "CI": "true"
        }
      },
      "group": "build",
      "problemMatcher": "$tsc"
    },
    {
      "label": "lint",
      "type": "shell",
      "command": "pnpm.cmd run lint",
      "options": {
        "env": {
          "CI": "true"
        }
      },
      "group": "test",
      "problemMatcher": "$eslint-stylish"
    },
    {
      "label": "Codex: current project",
      "type": "shell",
      "command": "codex",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "panel": "new",
        "focus": true,
        "reveal": "always"
      },
      "problemMatcher": []
    },
    {
      "label": "Codex: current project in new terminal",
      "type": "shell",
      "command": "${workspaceFolder}\\scripts\\open-codex.cmd",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "panel": "shared",
        "focus": false,
        "reveal": "silent"
      },
      "problemMatcher": []
    }
  ]
}
