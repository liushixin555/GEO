{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API: ts-node",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/with-local-env.cjs",
        "ts-node",
        "--project",
        "tsconfig.api.json",
        "apis/server.ts"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  ]
}
