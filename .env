# Server
PORT=8080
NODE_ENV=development

# Database (Prisma)
DATABASE_URL=postgresql://postgres:postgres@172.17.0.1:5432/geo_ts?schema=public

# JWT
JWT_SECRET=your-secret-key-change-in-production
