# Server
PORT=8080
NODE_ENV=development

# Database (Prisma)
DATABASE_URL=postgresql://postgres:postgres@172.17.0.1:5432/geo_ts?schema=public
DB_HOST=172.17.0.1
DB_PORT=5432
DB_NAME=geo_ts
DB_USER=postgres
DB_PASSWORD=postgres

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=2h

# Swagger
SWAGGER_ENABLED=true

# Rate Limit
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
