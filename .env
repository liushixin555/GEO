# Swagger
SWAGGER_ENABLED=true

# Rate Limit
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=500

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:12380,http://159.75.55.224:12380
